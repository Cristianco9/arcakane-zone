# Configuración para ejecutar el backend fuera de Docker (desarrollo local).
# Para el stack Docker, usa el .env de la raíz del repositorio.
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,backend
DATABASE_URL=postgres://usuario:clave@localhost:5432/arkane_zone

# Alternativa a DATABASE_URL: settings.py usa estas variables si DATABASE_URL
# está vacía (es lo que hace Docker Compose).
# POSTGRES_DB=arkane_zone
# POSTGRES_USER=arkane
# POSTGRES_PASSWORD=clave
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# Seguridad detrás de un proxy TLS. En local con DEBUG=True no aplica.
# SECURE_SSL_REDIRECT=False
# USE_X_FORWARDED_HOST=False

# Opcional: almacenamiento S3 para medios
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=media
# AWS_S3_ENDPOINT_URL=
# AWS_S3_REGION_NAME=us-west-2
# AWS_S3_CUSTOM_DOMAIN=
