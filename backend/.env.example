# Configuración para ejecutar el backend fuera de Docker (desarrollo local).
# Para el stack Docker, usa el .env de la raíz del repositorio.
# Solo para desarrollo. En producción se exige una clave real de >=50 chars:
#   openssl rand -hex 32
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,backend
DATABASE_URL=postgres://usuario:clave@localhost:5432/arkane_zone

# Días de vigencia de los tokens de API (defecto 7, mínimo 1).
API_TOKEN_TTL_DAYS=7
# Unidades máximas por línea del carrito (defecto 20, mínimo 1).
CARRITO_MAX_CANTIDAD_POR_LINEA=20

# Alternativa a DATABASE_URL: settings.py usa estas variables si DATABASE_URL
# está vacía (es lo que hace Docker Compose).
# POSTGRES_DB=arkane_zone
# POSTGRES_USER=arkane
# POSTGRES_PASSWORD=clave
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# Orígenes para CSRF y CORS cuando el frontend corre en otro puerto/dominio.
# Con el proxy /api de Vite/Nginx normalmente no son necesarios.
# CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Seguridad detrás de un proxy TLS. En local con DEBUG=True no aplica.
# SECURE_SSL_REDIRECT=True       # el proxy envía X-Forwarded-Proto: https
# USE_X_FORWARDED_HOST=False
# SECURE_REFERRER_POLICY=same-origin
# SESSION_COOKIE_SAMESITE=Lax
# SECURE_HSTS_PRELOAD=True       # solo si el dominio se someterá a preload
# LOG_LEVEL=INFO                 # DEBUG en desarrollo; JSON en producción

# ── Throttling y caché compartida ────────────────────────────────────────────
# Por defecto, contadores en PostgreSQL; crear la tabla con:
#   python manage.py createcachetable
# CACHE_TABLE=django_cache
# REDIS_URL=redis://localhost:6379/1  # requiere el paquete `redis`
# THROTTLE_NUM_PROXIES=0              # > 0 solo detrás de proxies de confianza
# THROTTLE_RATE_ANON=100/min
# THROTTLE_RATE_USER=1000/hour
# THROTTLE_RATE_LOGIN=10/min
# THROTTLE_RATE_REGISTRO=5/hour
# THROTTLE_RATE_CONTACTO=5/hour
# LOGIN_MAX_FAILED_ATTEMPTS=5
# LOGIN_FAILURE_WINDOW_SECONDS=900
# LOGIN_LOCKOUT_SECONDS=900

# Opcional: almacenamiento S3 para medios
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=media
# AWS_S3_ENDPOINT_URL=
# AWS_S3_REGION_NAME=us-west-2
# AWS_S3_CUSTOM_DOMAIN=
