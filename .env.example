# ─────────────────────────────────────────────────────────────────────────────
# Arcakane Zone — plantilla de variables para Docker Compose
#
# 1. Copia este archivo a .env en la raíz del repositorio:
#       cp .env.example .env
# 2. Reemplaza TODOS los valores "replace-with-..." por valores reales.
# 3. .env está excluido de Git. Nunca versiones credenciales reales.
#
# Los valores de abajo son FICTICIOS y solo ilustran el formato esperado.
# ─────────────────────────────────────────────────────────────────────────────

# ── Proyecto / imágenes / zona horaria ───────────────────────────────────────
COMPOSE_PROJECT_NAME=arkane-zone
IMAGE_TAG=local
TZ=America/Bogota

# Políticas de reinicio (desarrollo y producción).
RESTART_POLICY=unless-stopped
PROD_RESTART_POLICY=always

# ── Healthchecks ─────────────────────────────────────────────────────────────
HEALTHCHECK_INTERVAL=10s
HEALTHCHECK_TIMEOUT=5s
HEALTHCHECK_RETRIES=10
HEALTHCHECK_START_PERIOD=15s
BACKEND_HEALTHCHECK_START_PERIOD=40s
FRONTEND_HEALTHCHECK_START_PERIOD=20s
PGADMIN_HEALTHCHECK_START_PERIOD=30s

# ── Backend (Django) ─────────────────────────────────────────────────────────
# Genera una clave real con: openssl rand -hex 32
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Días de vigencia de los tokens de API (defecto 7, mínimo 1).
API_TOKEN_TTL_DAYS=7
# Unidades máximas por línea del carrito (defecto 20, mínimo 1).
CARRITO_MAX_CANTIDAD_POR_LINEA=20

# El reverse proxy envía X-Forwarded-Proto: https; el healthcheck interno
# también lo envía, así que la redirección HTTPS puede quedar activa.
# Para desarrollo local sin ese proxy (por ejemplo, npm run dev contra un
# backend local), usa SECURE_SSL_REDIRECT=False.
SECURE_SSL_REDIRECT=True
USE_X_FORWARDED_HOST=False
# Cabeceras/cookies endurecidas (AZ-S2-BE-09).
SECURE_REFERRER_POLICY=same-origin
SESSION_COOKIE_SAMESITE=Lax
SECURE_HSTS_PRELOAD=True
# Nivel de logs: DEBUG en desarrollo, INFO (JSON) en producción.
LOG_LEVEL=INFO

# ── Throttling y caché compartida ────────────────────────────────────────────
# Por defecto los contadores viven en la tabla CACHE_TABLE de PostgreSQL;
# el entrypoint ejecuta `createcachetable`, que es idempotente.
CACHE_TABLE=django_cache
# Si se define, se usa Redis en vez de la tabla (requiere el paquete `redis`).
REDIS_URL=
# 0 = usar solo REMOTE_ADDR. Solo poner > 0 si hay proxies propios delante;
# con 1 se toma la IP correcta de X-Forwarded-For (la más a la derecha).
THROTTLE_NUM_PROXIES=0

# Tasas DRF por scope. Una cadena vacía desactiva ese scope.
THROTTLE_RATE_ANON=100/min
THROTTLE_RATE_USER=1000/hour
THROTTLE_RATE_LOGIN=10/min
THROTTLE_RATE_REGISTRO=5/hour
THROTTLE_RATE_CONTACTO=5/hour

# Bloqueo de login: N fallos 401 en la ventana -> 429 con Retry-After.
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_FAILURE_WINDOW_SECONDS=900
LOGIN_LOCKOUT_SECONDS=900

# Nombre de servicio interno del backend y puertos.
BACKEND_HOST=backend
BACKEND_PORT=8000
BACKEND_PUBLISHED_PORT=8000
BACKEND_WORKERS=2
BACKEND_TIMEOUT=120

# Tareas que ejecuta el entrypoint al arrancar.
RUN_MIGRATIONS=true
COLLECTSTATIC=true
SEED_CATALOGO=false

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_DB=arkane_zone
POSTGRES_USER=replace-with-db-user
POSTGRES_PASSWORD=replace-with-a-strong-database-password
# Nombre de servicio en la red de Docker (no uses localhost).
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_PUBLISHED_PORT=5432

# ── pgAdmin ──────────────────────────────────────────────────────────────────
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=replace-with-a-strong-pgadmin-password
PGADMIN_PORT=80
PGADMIN_PUBLISHED_PORT=5050
PGADMIN_MASTER_PASSWORD_REQUIRED=False

# ── Frontend (Vite + React) ──────────────────────────────────────────────────
FRONTEND_PORT=8080
FRONTEND_PUBLISHED_PORT=5173
# Prefijo que el navegador usa para la API. El cliente agrega /v1.
VITE_API_BASE_URL=/api
