# ─────────────────────────────────────────────────────────────────────────────
# Arkane Zone — variables de entorno del stack Docker Compose
#
# 1. Copia este archivo a .env en la raíz del repositorio:
#       cp .env.example .env
# 2. Reemplaza TODOS los valores marcados como "replace-with-...".
# 3. .env está excluido de Git. Nunca versiones credenciales reales.
#
# Los valores de este ejemplo son ficticios y solo sirven como plantilla.
# ─────────────────────────────────────────────────────────────────────────────

# ── Proyecto / zona horaria ──────────────────────────────────────────────────
COMPOSE_PROJECT_NAME=arkane-zone
IMAGE_TAG=local
TZ=America/Bogota

# ── Backend (Django) ─────────────────────────────────────────────────────────
# Genera una clave con: openssl rand -hex 32
DJANGO_SECRET_KEY=replace-with-a-long-random-string
# true en desarrollo; en producción usa false (compose.prod.yaml lo fuerza).
DJANGO_DEBUG=True
# Hosts permitidos. En producción agrega tu dominio público.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
# Orígenes confiables para CSRF (admin de Django).
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://localhost:5173
# El healthcheck interno usa HTTP. Con TLS terminado en un proxy, déjalo en false.
SECURE_SSL_REDIRECT=False
USE_X_FORWARDED_HOST=False

# Host interno del backend (nombre de servicio Docker) y puertos.
BACKEND_HOST=backend
BACKEND_PORT=8000
BACKEND_PUBLISHED_PORT=8000
BACKEND_WORKERS=2
BACKEND_TIMEOUT=120

# Tareas de arranque del contenedor backend.
RUN_MIGRATIONS=true
COLLECTSTATIC=true
SEED_CATALOGO=false

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_DB=arkane_zone
POSTGRES_USER=arkane
POSTGRES_PASSWORD=replace-with-a-strong-database-password
# Nombre del servicio en la red de Docker (no uses localhost).
POSTGRES_HOST=db
# Puerto interno del servicio PostgreSQL y puerto publicado en el host.
POSTGRES_PORT=5432
POSTGRES_PUBLISHED_PORT=5432

# ── pgAdmin ──────────────────────────────────────────────────────────────────
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=replace-with-a-strong-pgadmin-password
# Puerto interno de pgAdmin y puerto publicado en el host.
PGADMIN_PORT=80
PGADMIN_PUBLISHED_PORT=5050

# ── Frontend (Vite + React) ──────────────────────────────────────────────────
# Puerto interno del contenedor y puerto publicado en el host.
FRONTEND_PORT=8080
FRONTEND_PUBLISHED_PORT=5173
# Ruta relativa que el navegador usa para llamar a la API.
VITE_API_BASE_URL=/api
# El proxy de Vite/Nginx se construye con BACKEND_HOST y BACKEND_PORT.
# Para desarrollo local sin Docker puedes exportar VITE_DEV_PROXY_TARGET
# (por ejemplo http://localhost:8000) antes de ejecutar npm run dev.
